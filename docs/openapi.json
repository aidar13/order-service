{
    "openapi": "3.0.0",
    "info": {
        "title": "Order Service API",
        "description": "Orders and payments. Called through the API gateway, which authenticates users.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/orders": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Own orders, newest first",
                "operationId": "955bb77a45ae173a485fadb8befed93f",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated orders"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Create an order; prices are taken from the catalogue",
                "operationId": "2123ba58dadb22bd6f2c8081af562230",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "delivery_address",
                                    "items"
                                ],
                                "properties": {
                                    "delivery_address": {
                                        "type": "string",
                                        "example": "12 Lake St"
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "sku": {
                                                    "type": "string",
                                                    "example": "BOX-M"
                                                },
                                                "quantity": {
                                                    "type": "integer",
                                                    "example": 10
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error / unknown product"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/orders/{id}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "An own order with items and payments",
                "operationId": "88d27387b1e409e075c18609d4a0c300",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/orders/{id}/cancel": {
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Cancel an unpaid order",
                "operationId": "4bff05b82387c6b20976c7b82ae2c9ba",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cancelled"
                    },
                    "409": {
                        "description": "Already paid or cancelled"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/orders/{id}/pay": {
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Start a payment; returns the provider payment page. Send Idempotency-Key to retry safely",
                "operationId": "bcb11a2e8c39c2388f69363632de9d29",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "provider": {
                                        "type": "string",
                                        "example": "fakepay"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Payment"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Order cannot be paid"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/payments/webhook/{provider}": {
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Payment result from a provider; authenticated by the X-Signature header (HMAC of the raw body)",
                "operationId": "a9bb84105c4ae9a962b9ae6e6b9aad3a",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "payment_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "succeeded",
                                            "failed"
                                        ]
                                    },
                                    "amount_cents": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Processed (also for duplicates)"
                    },
                    "401": {
                        "description": "Bad signature"
                    },
                    "422": {
                        "description": "Unknown payment / amount mismatch"
                    }
                },
                "x-unauthenticated": true
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Catalogue"
                ],
                "summary": "Product catalogue",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "responses": {
                    "200": {
                        "description": "Products"
                    }
                },
                "x-unauthenticated": true
            }
        }
    },
    "components": {
        "schemas": {
            "Order": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "number": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "new",
                            "paid",
                            "cancelled"
                        ]
                    },
                    "delivery_address": {
                        "type": "string"
                    },
                    "total_cents": {
                        "type": "integer"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    },
                    "payments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Payment"
                        }
                    }
                },
                "type": "object"
            },
            "Payment": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "provider": {
                        "type": "string",
                        "example": "fakepay"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "succeeded",
                            "failed",
                            "refund_required"
                        ]
                    },
                    "amount_cents": {
                        "type": "integer"
                    },
                    "payment_url": {
                        "type": "string",
                        "nullable": true
                    },
                    "failure_reason": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Orders",
            "description": "Orders"
        },
        {
            "name": "Payments",
            "description": "Payments"
        },
        {
            "name": "Catalogue",
            "description": "Catalogue"
        }
    ]
}